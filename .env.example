# Copy this file to .env and fill in real values. Never commit .env itself.

# Path to the Google service account JSON key file (downloaded in Phase 0)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-credentials.json

# Google Sheet IDs - the long string in the sheet's URL between /d/ and /edit
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ORDER_ID=
GOOGLE_SHEET_CF_TRACKER_ID=

# Neon Postgres connection string (from your Neon project dashboard)
# Format: postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=

# Gemini API key
GEMINI_API_KEY=

# Shared passkey for app login (Phase 3)
APP_PASSKEY=
